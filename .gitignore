# --- Compilacion (PlatformIO / Bruce) ---
# El arbol de Bruce se arma fuera del repo (tools/build.ps1 -> %USERPROFILE%\src\Bruce),
# pero si alguien lo clona adentro, que no se suba.
Bruce/
.pio/
.pioenvs/
.piolibdeps/
build/

# Objetos y salidas intermedias de C/C++
*.d
*.o
*.obj
*.elf
*.map
*.a
*.gch
*.pch
*.exe
*.dll

# El unico binario versionado es firmware/Bruce-m5stack-cardputer.bin
*.bin
!firmware/Bruce-m5stack-cardputer.bin

# Logs y temporales
*.log
*.tmp

# Python
__pycache__/
*.pyc

# Editores / sistema
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini
.DS_Store
